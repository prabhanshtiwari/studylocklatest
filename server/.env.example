# Study Lock Quiz / Social API — production environment template
# Replace every placeholder before deploying. Do not commit this file to Git.

NODE_ENV=production
PORT=3000

# MongoDB Atlas connection string. URL-encode special characters in the DB password.
MONGODB_URI=mongodb+srv://DB_USER:URL_ENCODED_PASSWORD@YOUR_CLUSTER_HOST/studylock?retryWrites=true&w=majority

# Generate a unique secret (at least 32 characters). Never reuse this example value.
JWT_SECRET=__REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS__
JWT_EXPIRES_IN=7d

# Public website origin; use the exact HTTPS origin without a trailing slash.
PUBLIC_APP_URL=https://studylock.prabhanshtiwari.com
CORS_ORIGINS=https://studylock.prabhanshtiwari.com

# Needed only for connecting the Chrome extension. Keep true for this project's extension flow.
ALLOW_EXTENSION_ORIGINS=true

# Production requires email verification.
REQUIRE_EMAIL_VERIFICATION=true
EMAIL_API_URL=https://api.resend.com/emails
EMAIL_API_KEY=re_REPLACE_WITH_YOUR_REAL_RESEND_API_KEY
EMAIL_FROM=Study Lock <no-reply@YOUR_VERIFIED_DOMAIN>

# Comma-separated email addresses that should receive the admin/moderator role at registration.
# Set your real admin email BEFORE registering that account.
ADMIN_EMAILS=your-admin-email@example.com
